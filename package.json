{
  "name": "cloudlab-web",
  "version": "0.2.0",
  "private": true,
  "description": "CloudLab web portal and isolated browser terminal gateway",
  "main": "local-server.js",
  "scripts": {
    "start": "node local-server.js",
    "test": "node --test tests/*.test.js",
    "migrate:git": "node scripts/migrate-json-repositories.js",
    "import:bigdata": "node scripts/import-bigdata-course.js local-data.json local-data.json",
    "import:frontend-backend": "node scripts/import-frontend-backend-course.js local-data.json local-data.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.11"
  }
}
